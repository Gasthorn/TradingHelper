# Détection automatique des fichiers texte, normalisés en LF dans l'index.
* text=auto

# Fins de ligne LF imposées aussi dans l'arbre de travail (Windows compris) :
# diffs « une barre par ligne » stables (P5) et `ruff format --check` reproductible.
*.py   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.lock text eol=lf
.python-version text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
