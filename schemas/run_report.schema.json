{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "IngestArgs": {
      "additionalProperties": false,
      "description": "Arguments de `th ingest` journalisés (P4).",
      "properties": {
        "symbols": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbols"
        },
        "full": {
          "title": "Full",
          "type": "boolean"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        }
      },
      "required": [
        "symbols",
        "full",
        "start"
      ],
      "title": "IngestArgs",
      "type": "object"
    },
    "IngestRun": {
      "additionalProperties": false,
      "description": "Une exécution de `th ingest` (F01 R15).",
      "properties": {
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "args": {
          "$ref": "#/$defs/IngestArgs"
        },
        "exit_code": {
          "enum": [
            0,
            1
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "tickers": {
          "items": {
            "$ref": "#/$defs/IngestTickerResult"
          },
          "title": "Tickers",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/IngestWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "duration_s",
        "args",
        "exit_code",
        "tickers",
        "warnings"
      ],
      "title": "IngestRun",
      "type": "object"
    },
    "IngestTickerResult": {
      "additionalProperties": false,
      "description": "Résultat de l'ingestion d'un symbole (F01 R15).",
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
          "title": "Symbol",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "unchanged",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "incremental",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mode"
        },
        "bars_added": {
          "minimum": 0,
          "title": "Bars Added",
          "type": "integer"
        },
        "bars_revised": {
          "minimum": 0,
          "title": "Bars Revised",
          "type": "integer"
        },
        "history_rewritten": {
          "title": "History Rewritten",
          "type": "boolean"
        },
        "rewrite_reason": {
          "anyOf": [
            {
              "enum": [
                "revision",
                "backfill"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rewrite Reason"
        },
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "symbol",
        "status",
        "mode",
        "bars_added",
        "bars_revised",
        "history_rewritten",
        "rewrite_reason",
        "attempts",
        "error"
      ],
      "title": "IngestTickerResult",
      "type": "object"
    },
    "IngestWarning": {
      "additionalProperties": false,
      "description": "Barre écartée ou anomalie non bloquante (F01 R3, R6).",
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
          "title": "Symbol",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "rule": {
          "enum": [
            "nan",
            "non_session_date",
            "after_last_session",
            "non_positive_price",
            "negative_volume",
            "ohlc_inconsistent",
            "duplicate_date",
            "missing_overlap_bar"
          ],
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "date",
        "rule"
      ],
      "title": "IngestWarning",
      "type": "object"
    },
    "ValidateArgs": {
      "additionalProperties": false,
      "description": "Arguments de `th validate` journalisés (P4).",
      "properties": {
        "symbols": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbols"
        },
        "all_history": {
          "title": "All History",
          "type": "boolean"
        }
      },
      "required": [
        "symbols",
        "all_history"
      ],
      "title": "ValidateArgs",
      "type": "object"
    },
    "ValidateRun": {
      "additionalProperties": false,
      "description": "Une exécution de `th validate` (F02 R8).",
      "properties": {
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "args": {
          "$ref": "#/$defs/ValidateArgs"
        },
        "exit_code": {
          "enum": [
            0,
            1
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "files_checked": {
          "minimum": 0,
          "title": "Files Checked",
          "type": "integer"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/ValidateViolation"
          },
          "title": "Violations",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ValidateWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "duration_s",
        "args",
        "exit_code",
        "files_checked",
        "violations",
        "warnings"
      ],
      "title": "ValidateRun",
      "type": "object"
    },
    "ValidateViolation": {
      "additionalProperties": false,
      "description": "Violation bloquante (F02 R1, R2). `symbol` est le nom du fichier sans `.json` : il peut\nne pas être un symbole valide (fichier orphelin quelconque).",
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "rule": {
          "enum": [
            "unreadable",
            "schema",
            "symbol_mismatch",
            "empty_bars",
            "dates_not_increasing",
            "non_session_date",
            "after_last_session",
            "non_positive_price",
            "negative_volume",
            "ohlc_inconsistent",
            "not_rounded"
          ],
          "title": "Rule",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "date",
        "rule",
        "detail"
      ],
      "title": "ValidateViolation",
      "type": "object"
    },
    "ValidateWarning": {
      "additionalProperties": false,
      "description": "Anomalie non bloquante (F02 R3), sur une barre (`start == end`) ou une plage de séances.\n\n`value` : variation simple pour `large_move`, nombre de séances pour `missing_session`\net `stale` ; absente sinon.",
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
          "title": "Symbol",
          "type": "string"
        },
        "rule": {
          "enum": [
            "missing_session",
            "large_move",
            "zero_volume",
            "stale",
            "missing_file"
          ],
          "title": "Rule",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "symbol",
        "rule",
        "start",
        "end"
      ],
      "title": "ValidateWarning",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Rapport de run d'une séance. Chaque commande met à jour sa seule section ;\nles sections des features suivantes (ex. `signal`) sont conservées telles quelles.\n\nSérialiser avec `by_alias=True` (clé JSON `validate`) et `exclude_unset=True` (une section\nabsente du fichier n'y est pas ajoutée vide).",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_date": {
      "format": "date",
      "title": "Session Date",
      "type": "string"
    },
    "ingest": {
      "items": {
        "$ref": "#/$defs/IngestRun"
      },
      "title": "Ingest",
      "type": "array"
    },
    "validate": {
      "items": {
        "$ref": "#/$defs/ValidateRun"
      },
      "title": "Validate",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "session_date"
  ],
  "title": "RunReport",
  "type": "object"
}
