{
  "name": "tradinghelper-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard statique de TradingHelper (GitHub Pages).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "gen:types": "node scripts/gen-types.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.15.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
